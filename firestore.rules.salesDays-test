rules_version = '2';
// EMULATOR TEST RULES ONLY - not deployed (firebase.json has no "firestore"
// section, so `firebase deploy` never touches the live rules in the console).
// The salesDays block is the one to paste into the console rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isManagement() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "management"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    // Stand-in for the other collections so the emulator app runs without noise.
    match /{col}/{id} {
      allow read, write: if request.auth != null && col != "salesDays" && col != "users";
    }
    match /salesDays/{day} {
      allow read, write: if isManagement();
    }
  }
}
